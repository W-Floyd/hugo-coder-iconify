{{- /*
  One feed per image quality tier, as the site's LOW/MED/HI toggle: index.xml
  is med, and index.low.xml and index.hi.xml are published beside it. They are
  resources rather than output formats: a custom output format would fall back
  to each shortcode's page template, losing the .rss.xml feed variants, and
  would need the site's [outputs] config. See feed/channel.xml for the content.
*/ -}}
{{- $dir := strings.TrimPrefix "/" .RelPermalink -}}
{{- range slice "low" "hi" -}}
  {{- $path := printf "%sindex.%s.xml" $dir . -}}
  {{- $xml := partial "feed/channel.xml" (dict "page" $ "quality" . "self" (absURL $path)) -}}
  {{- $_ := (resources.FromString $path (string $xml)).RelPermalink -}}
{{- end -}}
{{- partial "feed/channel.xml" (dict "page" . "quality" "med" "self" (.OutputFormats.Get "rss").Permalink) -}}
